#!name=B站装扮注入器 · 诊断包
#!desc=临时用：让收藏集奖励显示成可领取，好点进素材预览页触发解析请求。抓到东西后请关闭本模块。
#!system=ios
#!author=RNA

[Script]
# 只改客户端看到的进度数字（owned_item_amount = require_item_amount，
# 按钮文案改成「领取」）。服务端该拒还是拒，不会真的发放任何东西。
# 用途：收藏集奖励没达到条件时按钮是「进行中0/4」点不动，走不到素材预览页，
# 也就抓不到那个解析素材 id 的请求。开着它点进去，用主模块的抓包看请求。
BiliGarb-FakeUnlock = type=http-response,pattern=^https?://api\.bilibili\.com/x/vas/dlc_act/(lottery/collect_list|lottery_home_detail),requires-body=true,max-size=524288,script-path=https://gcore.jsdelivr.net/gh/Suk1u/BiliGarb@9dec7d6/bili-garb.js,timeout=10,argument=fake-unlock
